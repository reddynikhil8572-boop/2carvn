# Copy to .env for development. Never commit real secrets.
#
# `.env` is the base file and is also what the Prisma CLI reads.

NEXT_PUBLIC_SUPABASE_URL=https://qsjhrzhnzkiueggdaija.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xuXfjq6Pe2D_8zA8GErlMA_maZI4a1O
NODE_ENV=development
PORT=5000

# Test-only owner connection. Do not point this at a production or hosted
# database: the test suite drops and recreates its isolated test database.
# TEST_DIRECT_DATABASE_URL="postgresql://edusphere:edusphere@localhost:55432/edusphere?schema=public"

# Postgres — Supabase database connection.
#
# Get the database password and connection details from Supabase Dashboard >
# Connect. The publishable key is not a PostgreSQL password.
#
# URL-encode special characters in the password (`@`, `:`, `/`, `#`, etc.).

# Supabase session-mode pooler is required because the backend uses interactive
# Prisma transactions to set RLS context for each request.
DATABASE_URL="postgresql://postgres.qsjhrzhnzkiueggdaija:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_DATABASE_URL="postgresql://postgres.qsjhrzhnzkiueggdaija:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"
# Redis backs rate-limit counters so they are shared across API instances.
# REQUIRED in production — without it limits are per-process, which means N
# replicas allow N times the limit and every deploy resets the window.
# Optional locally; the app warns and falls back to in-memory counters.
REDIS_URL="rediss://default:gQAAAAAAAXU1AAIgcDFlMmQzODgyOTk4ZjU0ZjRhYTY4MDhjZDA3YjdkODk1Yg@generous-airedale-95541.upstash.io:6379"

# Required. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiYWRtaW4iOnRydWUsImlhdCI6MTUxNjIzOTAyMn0.KMUFsIDTnFmyG3nMiGM6H9FNFUROf3wh7SmqJp-QV30
JWT_REFRESH_SECRET=eyJhbciOiJIUzI1NiIskpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwib4gRG9lIiwiYWRtaW4iOnRydWUsImlhdCI6MTUxNjIzOTAyMn0.KMUFsIDTnFmyG3nMiG
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Comma-separated exact origins. Local dev servers are added automatically
# outside production, so this may be left empty for local work.
CORS_ORIGIN=http://localhost:3000
# Optional regex for preview deployments
# CORS_ORIGIN_PATTERN=^https://[a-z0-9-]+-myorg\.vercel\.app$

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Object storage. S3-compatible, so AWS S3, Cloudflare R2 and MinIO are
# interchangeable. REQUIRED in production — the API refuses to start without it
# rather than accepting uploads it cannot store.
#
# Values below point at the MinIO container from a host shell. Inside compose
# the API uses http://minio:9000 (set in docker-compose.yml).
S3_ENDPOINT=https://qsjhrzhnzkiueggdaija.storage.supabase.co/storage/v1/s3
# How a BROWSER reaches storage, when that differs from how the API does.
# Presigned URLs are rewritten to this before being handed out.
S3_PUBLIC_ENDPOINT=https://qsjhrzhnzkiueggdaija.storage.supabase.co/storage/v1/s3
S3_REGION=auto
S3_BUCKET=edusphere
S3_ACCESS_KEY_ID=edusphere
S3_SECRET_ACCESS_KEY=edusphere-secret
# MinIO addresses buckets by path (host/bucket/key); R2 and S3 use a virtual
# host (bucket.host/key). Wrong value gives a signature mismatch, not a clear
# error.
S3_FORCE_PATH_STYLE=true
