{
  "name": "edusphere-api",
  "version": "0.1.0",
  "description": "2carvn AI — multi-tenant LMS API",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec \"ts-node src/server.ts\"",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:watch": "vitest",
    "seed": "ts-node src/scripts/seed.ts",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "studio": "prisma studio"
  },
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/s3-presigned-post": "^3.1103.0",
    "@aws-sdk/s3-request-presigner": "^3.1103.0",
    "@prisma/client": "^6.2.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.4",
    "openssl": "^2.0.0",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.0",
    "redis": "^6.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.3",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "nodemon": "^3.1.14",
    "pg": "^8.22.0",
    "prisma": "^6.2.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.7"
  }
}
