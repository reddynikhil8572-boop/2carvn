# Copy to .env for local work. Only frontend-safe configuration lives here —
# never database URLs, JWT secrets, S3 credentials, SMTP passwords, Redis
# URLs with credentials, or encryption keys. The backend holds those.
#
# The backend serves the API under /api/v1 on this origin.
VITE_API_BASE_URL=http://localhost:5000

# Optional: absolute path the course player uses when a backend-provided video
# URL is relative. Leave blank to use the base URL.
# VITE_MEDIA_BASE_URL=